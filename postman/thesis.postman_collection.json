      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sign-up"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"rawPassword\": \"{{password}}\",\n  \"rawPasswordConfirm\": \"{{password}}\",\n  \"firstName\": \"Dev\",\n  \"lastName\": \"User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
